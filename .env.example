# Copy to .env.local for `pnpm dev` and the scripts. Set the same values in the
# Vercel project settings. Never commit real values.

ANTHROPIC_API_KEY=

# Supabase: server only. The browser never receives a Supabase key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Database password, used only by `pnpm db:migrate` (scripts/migrate.ts).
SUPABASE_PASSWORD=
# Optional: session pooler host if the project is not in Tokyo.
# SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com

# Shared secret the cron job must send as `Authorization: Bearer ...`.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
DAILY_CLAUDE_CALL_CAP=400

# Admin link for every board: /api/b/<slug>/admin/enter?token=<ADMIN_TOKEN>.
# It sets a 12 hour HttpOnly cookie and redirects to /b/<slug>/admin, so the
# token stays out of page URLs. Generate with `openssl rand -hex 16`. Empty
# means no admin page at all.
ADMIN_TOKEN=

# Optional model overrides while the eval decides (default claude-opus-5-5).
# EXTRACT_MODEL=claude-sonnet-5-5
# RECONCILE_MODEL=claude-sonnet-5-5
