{
  "name": "engawa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --import=tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import=tsx scripts/seed.ts",
    "eval": "node --env-file-if-exists=.env.local --import=tsx scripts/eval.ts",
    "eval:mask": "node --env-file-if-exists=.env.local --import=tsx scripts/eval-mask.ts",
    "purge": "node --env-file-if-exists=.env.local --import=tsx scripts/purge.ts",
    "latency": "node --env-file-if-exists=.env.local --import=tsx scripts/latency.ts",
    "guard": "node --import=tsx scripts/guard.ts",
    "board:throwaway": "node --env-file-if-exists=.env.local --import=tsx scripts/throwaway-board.ts",
    "check:placeholders": "node --import=tsx scripts/check-placeholders.ts",
    "check:inbox": "node --import=tsx scripts/check-inbox.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@supabase/supabase-js": "2.118.0",
    "jpeg-js": "0.4.4",
    "next": "16.4.4",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.1"
}
