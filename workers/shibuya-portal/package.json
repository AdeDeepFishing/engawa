{
  "name": "engawa-shibuya-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that posts the 渋谷区防災ポータル broadcasts into the shibuya board's official inbox",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "tail": "wrangler tail engawa-shibuya-portal --format pretty",
    "test": "node --import=tsx --test test/*.test.ts",
    "typecheck": "tsc -p . && tsc -p test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@10.12.1"
}
